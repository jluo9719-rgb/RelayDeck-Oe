# GEMINI_API_KEY: Optional in this app (not required for local Claude/Codex Bridge).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RelayDeck Windows Local Bridge Configuration
PORT="3000"
# Execution mode: "auto" (uses real local claude/codex CLI if found, else preview), "live", or "preview"
BRIDGE_EXEC_MODE="auto"
# Optional Bearer token for second-layer authentication behind Cloudflare Access
BRIDGE_AUTH_TOKEN=""
# Required secret to enable POST /api/sync-config (Windows CC Switch -> Cloud sync; disabled when empty)
BRIDGE_SYNC_SECRET=""
# Optional Cloudflare Zero Trust Access allowed email (verifies Cf-Access-Authenticated-User-Email header)
CF_ACCESS_ALLOWED_EMAIL=""
# Optional custom data storage directory for local session persistence
BRIDGE_DATA_DIR=".bridge-data"
